{
  "description": "Plumbline: checkpoints, gates and proof",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/plumbline\" hook session",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/plumbline\" hook session-task",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/plumbline\" hook session-finish",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/plumbline\" hook prompt",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/plumbline\" hook expansion",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Edit|Write|MultiEdit|NotebookEdit|Bash|Monitor|Read|AskUserQuestion|Agent|Task|SendMessage|SubagentHandback)$|^mcp__(?!.*(?:mempalace|socraticode|context7).*__)(?!.*serena.*__(?:find_symbol|find_referencing_symbols|get_symbols_overview|search_for_pattern|find_file|list_dir)$)",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/plumbline\" hook pre",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "^(Grep|Glob)$|^mcp__.*(?:mempalace|socraticode|context7).*__|^mcp__.*serena.*__(?:find_symbol|find_referencing_symbols|get_symbols_overview|search_for_pattern|find_file|list_dir)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/plumbline\" hook pre-search",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Grep|Edit|Write|MultiEdit|NotebookEdit|Bash|Monitor|AskUserQuestion|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/plumbline\" hook post",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|Monitor|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/plumbline\" hook post-failure",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^plumbline:(challenger|(plan|code|security|data|ux)-reviewer|tracer|builder|qa|tester)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/plumbline\" hook subagent-start",
            "timeout": 240
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^plumbline:(challenger|(plan|code|security|data|ux)-reviewer|tracer|builder|qa|tester)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/plumbline\" hook subagent-stop",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/plumbline\" hook session-end",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/plumbline\" hook stop",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
